{
  "name": "@spendexai/mcp",
  "version": "0.1.0",
  "description": "Spendex Pay — the wallet for your AI agent. MCP server that lets Claude Code, Cursor, ChatGPT, and any MCP-compatible agent sign up to and pay for any service.",
  "type": "module",
  "bin": {
    "spendex": "./dist/index.js",
    "@spendexai/mcp": "./dist/index.js",
    "spendexpay-mcp": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-widgets",
    "copy-widgets": "node -e \"import('node:fs').then(fs=>{fs.mkdirSync('dist/widgets',{recursive:true});for(const f of fs.readdirSync('src/widgets')){fs.copyFileSync('src/widgets/'+f,'dist/widgets/'+f)}})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "finetune:export": "tsx scripts/finetune/01-export-dataset.ts",
    "finetune:synth": "tsx scripts/finetune/02-synthesize-examples.ts",
    "finetune:prepare": "tsx scripts/finetune/03-prepare-mlx-data.ts",
    "finetune:eval": "tsx scripts/finetune/05-evaluate.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "wallet",
    "payments",
    "stripe-issuing",
    "claude-code",
    "cursor",
    "chatgpt"
  ],
  "homepage": "https://spendexai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/spendexai/mcp.git"
  },
  "author": "Spendex AI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "stripe": "^16.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
