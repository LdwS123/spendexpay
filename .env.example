# Copy this file to .env and fill in the values.
# Never commit .env — it contains secrets.

# ─── Dev mode ─────────────────────────────────────────────
# When SPENDEX_DEV=true, validateConfig() is skipped and missing
# credentials are replaced with placeholders. All tool calls return
# simulated responses — no real Stripe charges, no real Supabase writes.
# Set to "true" for local iteration, leave unset/false in production.
SPENDEX_DEV=false

# ─── Stripe (card, ACH, Apple Pay, Google Pay) ────────────
# https://dashboard.stripe.com/apikeys — use sk_test_... during dev
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the standard Stripe webhook endpoint (payment_intent.* events).
# Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the Stripe Issuing authorization webhook.
# Register a SEPARATE endpoint for issuing_authorization.request events at
#   https://your-domain.com/api/webhooks/stripe-issuing
# and copy its signing secret here. Must be different from STRIPE_WEBHOOK_SECRET
# so the two endpoints can be rotated independently.
STRIPE_ISSUING_WEBHOOK_SECRET=whsec_...
# ISO-4217 currency code used when issuing virtual cards via Stripe Issuing.
# Defaults to "eur" if unset. Must match the currency supported by your
# Stripe Issuing account (typically "usd" for US accounts, "eur" for EU,
# "gbp" for UK). Read by src/lib/stripe-issuing.ts at module load time.
STRIPE_CARD_CURRENCY=eur

# ─── PayPal ───────────────────────────────────────────────
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_SANDBOX=true   # set to false in production
# Webhook ID from the PayPal developer dashboard (Webhooks section of your app).
# Required for verifying the signature of incoming PayPal webhook events.
PAYPAL_WEBHOOK_ID=...

# ─── Coinbase Commerce (BTC, ETH, USDC, DAI) ──────────────
# https://commerce.coinbase.com/settings/security
COINBASE_COMMERCE_API_KEY=...
# Webhook signing secret from the Coinbase Commerce dashboard (Settings → Webhooks).
# Used to verify HMAC-SHA256 signatures on inbound charge events via the
# X-CC-Webhook-Signature header. Copy this value when creating the webhook endpoint
# — it is shown only once. Rotate it in the dashboard if it is ever compromised.
COINBASE_COMMERCE_WEBHOOK_SECRET=...

# ─── Circle (USDC on Base) ────────────────────────────────
# https://console-sandbox.circle.com — create a Programmable Wallet
CIRCLE_API_KEY=...
CIRCLE_TREASURY_WALLET_ID=...  # Spendex entity wallet that receives payments
CIRCLE_SANDBOX=true            # set to false in production
# Subscription ID of the Circle webhook endpoint registered in the Circle console.
# Circle delivers events via SNS-style HTTP notifications. Each registered endpoint
# receives a unique subscriptionId that is included in every notification payload.
# We verify this ID to ensure webhook events originate from our own Circle subscription.
# Find this in the Circle console under Notifications → Subscriptions.
CIRCLE_WEBHOOK_SUBSCRIPTION_ID=...

# ─── Supabase ─────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
# NOTE: src/config.ts reads SUPABASE_SERVICE_ROLE_KEY. Several dashboard
# routes accept either SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SERVICE_KEY
# as a fallback — prefer SUPABASE_SERVICE_ROLE_KEY everywhere for consistency.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── MCP token hashing ────────────────────────────────────
# HMAC-SHA256 key used to hash raw MCP tokens (spx_…) before lookup.
# The dashboard issuing tokens MUST use the same value, otherwise the
# hash stored in users.mcp_token will never match. Generate once with:
#   openssl rand -hex 32
# and keep it in sync between the MCP server and the dashboard.
MCP_TOKEN_SALT=replace-with-a-long-random-secret

# ─── Test charge mode ─────────────────────────────────────
# When SPENDEX_TEST_CHARGE=true, tools that would normally cost $0 (Vercel
# Pro deploys, free-tier Modal runs, …) charge a small symbolic amount
# instead so the Stripe payment path can be exercised end-to-end against
# test keys. Leave unset (or set to "false") in production.
SPENDEX_TEST_CHARGE=false

# ─── App / Dashboard URLs ─────────────────────────────────
# Public base URL used by src/lib/payments/stripe-wallet.ts to build
# Apple Pay / Google Pay approval links. Defaults to https://spendexai.com.
SPENDEX_APP_URL=https://spendexai.com
# Public base URL of the Spendex dashboard app. Used by the consent layer
# (src/config.ts → dashboardUrl) to POST fire-and-forget notifications to
# /api/notify/consent and to build consent decision links inside emails
# and Telegram messages. Re-read on every access (no restart needed).
SPENDEX_DASHBOARD_URL=https://app.spendexai.com

# Shared secret used to authenticate server-to-server POSTs from the MCP
# server to the dashboard's /api/notify/consent endpoint. The MCP server
# sends it in the `x-internal-token` header; the dashboard rejects any
# request whose token does not match in constant time. MUST be identical
# on both sides. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_INTERNAL_TOKEN=replace-with-a-long-random-secret

# ─── Managed account credential encryption ───────────────
# AES-256-GCM key used to encrypt managed_accounts.password_encrypted at rest.
# 32 bytes, hex-encoded. Generate once with `openssl rand -hex 32` and store
# it in a secret manager — losing this key makes every managed account
# password unrecoverable.
MANAGED_ACCOUNT_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ─── Anthropic (smart rules engine, classify_purchase_intent) ─────
# Used to classify every pay_for_service call into a (category, urgency,
# risk_score) tuple via Claude Haiku 4.5. Smart rules (category_blocklist,
# risk_threshold, category_max_per_month, urgency_requires_consent) all
# depend on this classification. OPTIONAL: if the key is absent the
# classifier returns a neutral "unknown" fallback (risk_score=50) and
# does NOT block the charge — static numeric caps still protect the user.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Classifier backend ──────────────────────────────────
# Which backend powers the purchase-intent classifier. Two options:
#   "anthropic" (default) → Claude Haiku 4.5 via ANTHROPIC_API_KEY above.
#   "ollama"              → local Ollama model (see OLLAMA_* vars below).
# Unset behaves identically to "anthropic" — fully backward compatible.
# See docs/FINETUNING.md for how to train and deploy the Ollama backend.
CLASSIFIER_BACKEND=anthropic

# ─── Ollama (only used when CLASSIFIER_BACKEND=ollama) ───
# Base URL of a running Ollama server. Localhost is the typical case;
# point this at a private GPU host if you run a shared inference box.
OLLAMA_BASE_URL=http://localhost:11434
# Model tag served by Ollama. Use "llama3.2:3b" for the untuned baseline,
# or "spendex-classifier:v1" (or your chosen tag) after running the
# fine-tuning pipeline in scripts/finetune/.
OLLAMA_MODEL=llama3.2:3b

# ─── Resend (inbound email parsing) ───────────────────────
# Signing secret for the Resend inbound-email webhook
# (/api/webhooks/email-inbound). Verifies the svix-signature header.
RESEND_WEBHOOK_SECRET=whsec_...

# ─── Telegram bot (consent notifications) ─────────────────
# Create the bot via @BotFather, then set the webhook to
# https://app.spendexai.com/api/webhooks/telegram with
# secret_token=TELEGRAM_WEBHOOK_SECRET. See docs/telegram-bot-setup.md
# for the full setup procedure.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# ─── Kill switch ──────────────────────────────────────────
# Set to "true" to immediately block all payment processing.
# Read fresh on every access — toggling it takes effect without restart.
EMERGENCY_STOP=false
