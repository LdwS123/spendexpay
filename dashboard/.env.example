# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it contains secrets.
# See the MCP server's .env.example for the full backend variable list.

# ─── Dev mode ─────────────────────────────────────────────
# When SPENDEX_DEV=true, several API routes (onboarding, settings/profile)
# and the Stripe Issuing webhook short-circuit with simulated responses.
SPENDEX_DEV=false

# ─── Stripe ───────────────────────────────────────────────
# Publishable key is safe to expose to the browser (NEXT_PUBLIC_ prefix).
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key is server-only — never prefix with NEXT_PUBLIC_.
# Used by /pay/[intentId] to retrieve client_secret from Stripe server-side,
# and by /api/webhooks/stripe to verify webhook signatures.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — obtained from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or from the Stripe dashboard Webhooks section.
STRIPE_WEBHOOK_SECRET=whsec_...

# Signing secret for the Stripe Issuing authorization webhook
# (/api/webhooks/stripe-issuing). Must be different from STRIPE_WEBHOOK_SECRET
# so the two endpoints can be rotated independently.
STRIPE_ISSUING_WEBHOOK_SECRET=whsec_...

# ISO-4217 currency code used when issuing virtual cards via Stripe Issuing
# from the onboarding flow. Defaults to "eur" if unset.
STRIPE_CARD_CURRENCY=eur

# ─── Supabase ─────────────────────────────────────────────
# Dashboard-facing variables.
# https://supabase.com/dashboard/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are safe for
# the browser — they rely on Row Level Security policies being correctly set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Some server-only webhook handlers (stripe, stripe-issuing, telegram,
# email-inbound, consent, notify) fall back to the non-prefixed SUPABASE_URL
# when NEXT_PUBLIC_SUPABASE_URL is unset. Set both to the same value in prod.
SUPABASE_URL=https://your-project.supabase.co

# Service role key — server-only, bypasses RLS. Only used in server components
# and Route Handlers. Never prefix with NEXT_PUBLIC_.
# Several routes accept SUPABASE_SERVICE_KEY as a legacy fallback; prefer
# SUPABASE_SERVICE_ROLE_KEY everywhere for consistency.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ──────────────────────────────────────────────────
# Used in metadata, post-signout redirects, and for building absolute URLs
# (e.g. OG images, email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the dashboard, used by email templates to build
# consent decision links. Falls back to NEXT_PUBLIC_APP_URL if unset.
SPENDEX_DASHBOARD_URL=https://app.spendexai.com

# ─── Internal consent-notification auth ───────────────────
# Shared secret used to authenticate server-to-server POSTs from the MCP
# server to /api/notify/consent. The MCP server sends it in the
# `x-internal-token` header; this route rejects any request whose token
# does not match in constant time. MUST be identical to NOTIFY_INTERNAL_TOKEN
# set on the MCP server. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_INTERNAL_TOKEN=replace-with-a-long-random-secret

# ─── MCP token hashing ────────────────────────────────────
# Random secret used as the HMAC-SHA256 key when hashing MCP tokens before
# storing them in the database. The raw token is shown to the user once and
# then discarded — only the hash lives in users.mcp_token.
# MUST match the value the MCP server uses — otherwise issued tokens will
# never match at lookup time.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN_SALT=changeme_generate_a_random_64_char_hex_string

# ─── Managed account credential encryption ───────────────
# AES-256-GCM key used to encrypt managed_accounts.password_encrypted at rest.
# 32 bytes, hex-encoded. MUST match the MCP server's value if both apps
# decrypt the same rows. Generate with `openssl rand -hex 32`.
MANAGED_ACCOUNT_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ─── Resend (transactional + inbound email) ───────────────
# API key for sending transactional and consent-notification emails.
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# From address used on outbound mail. Defaults to "Spendex Pay <hello@spendexai.com>".
RESEND_FROM_EMAIL=Spendex Pay <hello@spendexai.com>
# Signing secret for the Resend inbound-email webhook
# (/api/webhooks/email-inbound). Verifies the svix-signature header.
RESEND_WEBHOOK_SECRET=whsec_...

# ─── PayPal webhook verification ──────────────────────────
# Required by /api/webhooks/paypal to verify inbound PayPal events via
# the PayPal verify-webhook-signature endpoint.
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
PAYPAL_SANDBOX=true   # set to "false" to hit the live PayPal API

# ─── Coinbase Commerce webhook ────────────────────────────
# Signing secret for /api/webhooks/coinbase (X-CC-Webhook-Signature).
COINBASE_COMMERCE_WEBHOOK_SECRET=...

# ─── Circle webhook ───────────────────────────────────────
# Signing secret for /api/webhooks/circle.
CIRCLE_WEBHOOK_SECRET=...

# ─── Telegram bot (consent notifications) ─────────────────
# Bot token from @BotFather and the secret_token used when registering
# the webhook at /api/webhooks/telegram. See docs/telegram-bot-setup.md.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# ─── Web Push (browser notifications) ─────────────────────
# Generate once per environment with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY MUST be identical —
# the NEXT_PUBLIC_ copy is shipped to the browser, the bare one is used
# server-side when signing pushes. VAPID_PRIVATE_KEY stays server-only.
# VAPID_SUBJECT identifies who's sending the push to the push service —
# `mailto:` URLs are the only widely-supported form today.
VAPID_PUBLIC_KEY=BEerPMZoLB4iVVcHpzBU9rMMk4Gjq6lfwRnIIBkNS8B4FyJSeqVjKo--VaBUFVjW4YJp2It85TszMj8L6bsxzFI
VAPID_PRIVATE_KEY=Mr4y2G-h1oSjU3z0GrfGfGpu2hNZocFtPnFXdjz-A8M
VAPID_SUBJECT=mailto:ops@spendexai.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEerPMZoLB4iVVcHpzBU9rMMk4Gjq6lfwRnIIBkNS8B4FyJSeqVjKo--VaBUFVjW4YJp2It85TszMj8L6bsxzFI

# ─── Twilio (inbound SMS webhook) ─────────────────────────
# Spendex leases a Twilio number per user. Twilio POSTs inbound SMS to
# /api/webhooks/twilio-sms; that route validates X-Twilio-Signature using
# HMAC-SHA1(TWILIO_AUTH_TOKEN, url + sorted params), then inserts into
# the sms_messages table for the MCP `get_sms_code` tool to consume.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Comma-separated list of preferred area codes for new number leases.
TWILIO_VIRTUAL_NUMBER_POOL=415,212,646

# ─── Kill switch ──────────────────────────────────────────
# Set to "true" to immediately block all payment processing
# (checked by the Stripe Issuing authorization webhook).
EMERGENCY_STOP=false

# ─── Auth ─────────────────────────────────────────────────
# Auth is handled by Supabase (@supabase/ssr + middleware.ts).
# No additional secrets are required beyond the Supabase keys above.
# To create the first user: Supabase dashboard → Authentication → Users → Add user.
